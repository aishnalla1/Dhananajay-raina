{
  "routes": [
    {
      "route": "/videos/*",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, max-age=0"
      }
    },
    {
      "route": "/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "mimeTypes": {
    ".mp4": "video/mp4"
  }
}